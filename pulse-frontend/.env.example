# =============================================================================
# PULSE Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# API Configuration
# =============================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# Enable/disable API request retries
VITE_API_RETRY_ENABLED=true

# Number of retry attempts for failed requests
VITE_API_RETRY_COUNT=3

# =============================================================================
# WebSocket Configuration
# =============================================================================

# WebSocket endpoint URL
VITE_WS_URL=http://localhost:8080/ws

# Enable/disable WebSocket connection (set to 'false' to disable)
VITE_ENABLE_WEBSOCKET=true

# WebSocket reconnection attempts
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# =============================================================================
# Google Maps Configuration
# =============================================================================

# Google Maps JavaScript API Key
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID (for custom styling)
VITE_GOOGLE_MAPS_MAP_ID=

# =============================================================================
# Authentication Configuration
# =============================================================================

# JWT token storage key name
VITE_AUTH_TOKEN_KEY=pulse_auth_token

# Session timeout in minutes (default: 60)
VITE_SESSION_TIMEOUT=60

# Enable demo mode (bypasses real authentication)
VITE_DEMO_MODE=true

# =============================================================================
# Feature Flags
# =============================================================================

# Enable AI Triage feature
VITE_FEATURE_AI_TRIAGE=true

# Enable Family Portal feature
VITE_FEATURE_FAMILY_PORTAL=true

# Enable Chat feature
VITE_FEATURE_CHAT=true

# Enable Video Calls feature
VITE_FEATURE_VIDEO_CALLS=true

# =============================================================================
# Logging & Debugging
# =============================================================================

# Log level: 'debug' | 'info' | 'warn' | 'error' | 'none'
VITE_LOG_LEVEL=debug

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# =============================================================================
# Third-Party Integrations
# =============================================================================

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# Analytics tracking ID (optional)
VITE_ANALYTICS_ID=

# =============================================================================
# Environment
# =============================================================================

# Environment name: 'development' | 'staging' | 'production'
VITE_ENV=development
